# ========================================================
# Telegram Anti-DDoS Sentinel Guard - Credentials
# ========================================================

# ১. my.telegram.org থেকে আপনার API ID এবং API HASH নিবেন
API_ID=12345678
API_HASH=abcdef1234567890abcdef1234567890

# ২. যে টেলিগ্রাম অ্যাকাউন্টে চ্যানেলের Ownership বা Admin পারমিশন আছে
PHONE_NUMBER=+8801XXXXXXXXX

# ৩. আপনার পাবলিক চ্যানেলের ইউজারনেম (অথবা আইডি)
TARGET_CHANNEL=@your_public_channel

# ৪. লাইভ স্ট্রিম টাইটেল
LIVE_STREAM_TITLE=🔴 লাইভ স্ট্রিম (সুরক্ষিত ও সচল)

# ৫. সেটিংস
AUTO_RESPAWN_DELAY_MS=300
ENABLE_SNIFFER_HUNTER=True
SCAN_INTERVAL_SECONDS=0.5
